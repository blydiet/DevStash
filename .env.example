# Fixed, trusted base URL for this deployment (no trailing slash). Used to build
# absolute links in emails (verification/password-reset) instead of trusting the
# request's Host header, which can be spoofed. Optional on Vercel branch/preview
# deployments — falls back to the stable VERCEL_BRANCH_URL system env var there.
APP_URL=

# Neon Postgres connection strings for this branch (dev/prod use separate Neon branches).
# DATABASE_URL (pooled, "-pooler" host) is used by the app's Prisma Client at runtime.
# DIRECT_URL (no "-pooler") is used by the Prisma CLI (migrate/introspect), which needs
# a direct connection to hold advisory locks/session state across statements — required
# in prisma.config.ts's datasource.url, not just a fallback.
DATABASE_URL=
DIRECT_URL=

# NextAuth v5 secret, generate with `npx auth secret`
AUTH_SECRET=

# GitHub OAuth App credentials (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Client credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend API key, used for verification/password-reset emails (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional. Defaults to enabled. Set to "false" to disable the email-verification
# requirement entirely (skips sending on register, skips the block on sign-in,
# auto-verifies new users).
EMAIL_VERIFICATION_ENABLED=

# Optional. Upstash Redis REST credentials (https://console.upstash.com) used by
# src/lib/rate-limit.ts to throttle auth endpoints (sign-in, register, forgot-password,
# reset-password, resend-verification). Rate limiting fails open when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Cloudflare R2 Storage credentials for this branch (dev/prod use separate R2 buckets).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""  
R2_PUBLIC_URL=""


# Stripe 
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""  
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""


#Open AI
OPENAI_API_KEY=""
# Optional. Defaults to "gpt-5.6-luna" if unset.
OPENAI_MODEL=""